# TLS-terminating reverse proxy in front of NodeWatch (nginx). Tested against
# NodeWatch with NODEWATCH_COOKIE_SECURE=true. Replace the certificate paths
# with your own (e.g. from your LAN CA); this block goes inside `http { }`.
server {
    listen 443 ssl;
    server_name nodewatch.lan;

    ssl_certificate     /etc/ssl/nodewatch/cert.pem;
    ssl_certificate_key /etc/ssl/nodewatch/key.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
